// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique @db.VarChar
  password     String?       @db.VarChar
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  managerId    String?       @db.Uuid
  manager      Manager?      @relation(fields: [managerId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

model Manager {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar
  password  String?  @db.VarChar
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  users     User[]
}

model Reservation {
  id                     Int                      @id @default(autoincrement())
  userId                 String                   @db.Uuid
  name                   String                   @db.VarChar
  start                  DateTime                 @db.Timestamptz
  end                    DateTime                 @db.Timestamptz
  createdAt              DateTime                 @default(now()) @db.Timestamptz
  updatedAt              DateTime                 @updatedAt @db.Timestamptz
  user                   User                     @relation(fields: [userId], references: [id])
  siteId                 Int
  site                   Site                     @relation(fields: [siteId], references: [id])
  equipment              EquipmentOnReservation[]
}

model Site {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  reservations Reservation[]
}

model Equipment {
  id                     BigInt @id @default(autoincrement())
  name                   String                   @unique @db.VarChar
  createdAt              DateTime                 @default(now()) @db.Timestamptz
  updatedAt              DateTime                 @updatedAt @db.Timestamptz
  reservations           EquipmentOnReservation[]
  stock                  Int                      @default(0) // 在庫数を表すフィールドを追加
}

model EquipmentOnReservation {
  reservationId Int
  equipmentId   BigInt
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  equipment     Equipment   @relation(fields: [equipmentId], references: [id])
  quantity      Int         @default(1) // 使用数を表すフィールドを追加
  @@id([equipmentId, reservationId])
}

